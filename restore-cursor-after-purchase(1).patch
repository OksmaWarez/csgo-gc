+// Make the mouse cursor visible, release any mouse grab / relative mouse mode
+// held by the game window and re-center the pointer in it. The game hides the cursor while it waits for the Steam
+// overlay checkout during a store purchase; since the checkout is simulated, the
+// overlay never hands the cursor back on Linux and macOS (alt-tabbing restores it
+// because SDL re-evaluates the cursor state on focus change). Must be called from
+// the main thread. No-op on Windows.
+void RestoreMouseCursor();
+
 } // namespace Platform
diff --git a/csgo_gc/platform_unix.cpp b/csgo_gc/platform_unix.cpp
index 82afdef..a2e4b82 100644
--- a/csgo_gc/platform_unix.cpp
+++ b/csgo_gc/platform_unix.cpp
@@ -770,4 +770,85 @@ int GetModuleBitness(std::string_view moduleName)
     return 0;
 }
 
+// Binds to the SDL2 the game already loaded (RTLD_NOLOAD) so we never pull in a
+// second copy of the library, which would have its own, unrelated window state.
+static void *FindLoadedSDL2()
+{
+#if defined(__APPLE__)
+    static const char *const names[] = { "libSDL2-2.0.0.dylib", "libSDL2.dylib", "@rpath/libSDL2-2.0.0.dylib" };
+#else
+    static const char *const names[] = { "libSDL2-2.0.so.0", "libSDL2.so" };
+#endif
+
+    for (const char *name : names)
+    {
+        void *handle = dlopen(name, RTLD_LAZY | RTLD_NOLOAD);
+        if (handle)
+        {
+            return handle;
+        }
+    }
+
+    return nullptr;
+}
+
+void RestoreMouseCursor()
+{
+    using SDL_ShowCursor_t = int (*)(int);
+    using SDL_SetRelativeMouseMode_t = int (*)(int);
+    using SDL_GetKeyboardFocus_t = void *(*)();
+    using SDL_SetWindowGrab_t = void (*)(void *, int);
+    using SDL_GetWindowSize_t = void (*)(void *, int *, int *);
+    using SDL_WarpMouseInWindow_t = void (*)(void *, int, int);
+
+    void *sdl = FindLoadedSDL2();
+    if (!sdl)
+    {
+        Print("RestoreMouseCursor: SDL2 is not loaded, nothing to do\n");
+        return;
+    }
+
+    auto showCursor = reinterpret_cast<SDL_ShowCursor_t>(dlsym(sdl, "SDL_ShowCursor"));
+    auto setRelativeMouseMode = reinterpret_cast<SDL_SetRelativeMouseMode_t>(dlsym(sdl, "SDL_SetRelativeMouseMode"));
+    auto getKeyboardFocus = reinterpret_cast<SDL_GetKeyboardFocus_t>(dlsym(sdl, "SDL_GetKeyboardFocus"));
+    auto setWindowGrab = reinterpret_cast<SDL_SetWindowGrab_t>(dlsym(sdl, "SDL_SetWindowGrab"));
+    auto getWindowSize = reinterpret_cast<SDL_GetWindowSize_t>(dlsym(sdl, "SDL_GetWindowSize"));
+    auto warpMouseInWindow = reinterpret_cast<SDL_WarpMouseInWindow_t>(dlsym(sdl, "SDL_WarpMouseInWindow"));
+
+    // SDL_ShowCursor(1) is "enable", and SDL_SetRelativeMouseMode(0) also restores
+    // the cursor position/visibility that relative mode changed
+    if (setRelativeMouseMode)
+    {
+        setRelativeMouseMode(0);
+    }
+
+    void *window = getKeyboardFocus ? getKeyboardFocus() : nullptr;
+    if (window && setWindowGrab)
+    {
+        setWindowGrab(window, 0);
+    }
+
+    if (showCursor)
+    {
+        showCursor(1);
+    }
+
+    // Leaving relative mouse mode puts the real pointer back where it was before
+    // the mode was entered, which no longer matches where the game's UI thinks the
+    // cursor is. Warp to the center of the window so both agree again. The warp
+    // also generates a motion event the game picks up.
+    if (window && getWindowSize && warpMouseInWindow)
+    {
+        int width = 0, height = 0;
+        getWindowSize(window, &width, &height);
+        if (width > 0 && height > 0)
+        {
+            warpMouseInWindow(window, width / 2, height / 2);
+        }
+    }
+
+    Print("Restored mouse cursor after store purchase\n");
+    dlclose(sdl);
+}
+
 } // namespace Platform
